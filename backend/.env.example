# WhatsApp Task Manager - Environment Variables
# Copy this to .env and fill in your real values

# Kapso WhatsApp API Credentials
# Get from: https://app.kapso.ai → Settings → API Keys
KAPSO_API_KEY=your_kapso_api_key_here

# Phone Number ID from Kapso dashboard → Connected Numbers
PHONE_NUMBER_ID=your_phone_number_id_here

# Kapso API Base URL (usually no need to change)
KAPSO_API_BASE=https://api.kapso.ai/meta/whatsapp/v24.0

# Kapso Workflow ID (for EOD task status collection - Stage 7)
WORKFLOW_ID=your_workflow_id_here

# Flask Configuration
FLASK_ENV=development
FLASK_PORT=5001
FLASK_DEBUG=true

# Frontend URL (for generating submission links)
FRONTEND_URL=http://localhost:5173

# Scheduler Configuration
EOD_TRIGGER_HOUR=17
EOD_TRIGGER_MINUTE=0
TIMEZONE=Asia/Kolkata
